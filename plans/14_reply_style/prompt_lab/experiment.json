{
 "providers": {
  "openai": {
   "base_url": "https://api.openai.com/v1",
   "api_key_env": "OPENAI_API_KEY"
  }
 },
 "models": {
  "gpt-5.4-nano": {
   "provider": "openai",
   "model": "gpt-5.4-nano",
   "params": {
    "reasoning_effort": "none",
    "temperature": 0.7
   }
  },
  "gpt-6-luna": {
   "provider": "openai",
   "model": "gpt-6-luna",
   "params": {
    "reasoning_effort": "none",
    "temperature": 0.7
   }
  },
  "gpt-4o-mini": {
   "provider": "openai",
   "model": "gpt-4o-mini",
   "params": {
    "temperature": 0.7
   }
  },
  "judge": {
   "provider": "openai",
   "model": "gpt-5.4-mini"
  }
 },
 "compare": [
  "gpt-5.4-nano",
  "gpt-6-luna",
  "gpt-4o-mini"
 ],
 "judge": {
  "model": "judge",
  "params": {
   "reasoning_effort": "low"
  }
 },
 "request": {
  "max_completion_tokens": 512
 },
 "schema": "../../../assets/prompts/tutor_response_schema.json",
 "prompts": {
  "v3": "../../../assets/prompts/tutor_response/v3.txt",
  "v4": "v4.txt",
  "v5": "v5.txt",
  "v6": "v6.txt",
  "v7": "v7.txt"
 },
 "conversation": "conversation.json",
 "variables": {
  "target_language": "Brazilian Portuguese",
  "explanation_language": "English",
  "topic": ""
 },
 "tables": {
  "level_guide": "level_guide.json",
  "cefr_sample": "cefr_sample.json",
  "length_rule": "length_rule.json"
 },
 "optional_variables": [
  "length_rule"
 ],
 "setups": [
  {
   "prompt": "v7",
   "vars": {
    "cefr_level": "B1",
    "length": "normal"
   }
  },
  {
   "prompt": "v7",
   "vars": {
    "cefr_level": "C2",
    "length": "normal"
   }
  },
  {
   "prompt": "v7",
   "vars": {
    "cefr_level": "B2",
    "length": "short"
   }
  },
  {
   "prompt": "v7",
   "vars": {
    "cefr_level": "B2",
    "length": "long"
   }
  }
 ]
}